# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ATproto identity — used by Sequoia CLI and the atproto-check/cleanup tasks.
# Handle for your PDS (e.g. your domain if self-hosted, or yourname.bsky.social).
ATP_IDENTIFIER=you.example.com

# ATproto app password — create one at https://bsky.app/settings/app-passwords
# Never use your main account password here.
ATP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Cloudflare — only needed for manual deploys (normally handled by CI).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Dev server host baked into internal links (`task dev`). Leave unset for local
# browsing (defaults to localhost). On a headless box you reach from another
# machine (e.g. over Tailscale), set this to the box's reachable name so the
# dev server's links resolve from your laptop instead of pointing at localhost.
# DEV_HOST=claudes-plan
