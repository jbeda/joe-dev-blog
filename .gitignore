# Hugo build output
/public/
/resources/_gen/
.hugo_build.lock

# OS
.DS_Store

# Local Claude Code settings
.claude/

# Local environment variables (copy from .env.example, never commit)
.env

# Downloaded fonts (local tooling only, not committed)
/fonts/

# Python tooling runs ephemerally via `uv run` (no managed venv); ignore stray
# bytecode and any leftover venv from the old setup.
__pycache__/
/scripts/.venv/

# Task runner cache
/.task/

# Node dependencies (graphics-gen/, tools/)
node_modules/

# Local visual + a11y check output
/.a11y-shots/

